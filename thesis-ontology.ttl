@prefix : <http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/> .
@base <http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance> .

<http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance> rdf:type owl:Ontology ;
                                                                               owl:imports <http://www.w3.org/2004/02/skos/core> ;
                                                                               rdfs:comment "This is an ontology containing the AI Act and the Dutch Algoritmekader"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#appliesToStage
:appliesToStage rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#hasRiskGroup
:hasRiskGroup rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain skos:AISystem ;
              rdfs:range skos:RiskGroup .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#relevantForRole
:relevantForRole rdf:type owl:ObjectProperty ;
                 rdfs:range skos:AlgoritmekaderRole .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#supportsRequirement
:supportsRequirement rdf:type owl:ObjectProperty ;
                     rdfs:domain skos:Tool ;
                     rdfs:range skos:Requirement .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#typicallyFollowedBy
:typicallyFollowedBy rdf:type owl:ObjectProperty ;
                     rdfs:domain skos:LifecycleStage ;
                     rdfs:range skos:LifecycleStage .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/appliesToRiskGroup
skos:appliesToRiskGroup rdf:type owl:ObjectProperty ;
                        rdfs:domain skos:Requirement ;
                        rdfs:range skos:RiskGroup .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/appliesToRole
skos:appliesToRole rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf owl:topObjectProperty ;
                   rdfs:domain skos:Requirement ;
                   rdfs:range skos:AIActRole .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/derivedFrom
skos:derivedFrom rdf:type owl:ObjectProperty ;
                 rdfs:domain skos:Requirement ;
                 rdfs:range skos:LegalSource .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/implements
skos:implements rdf:type owl:ObjectProperty ;
                rdfs:domain skos:Measure ;
                rdfs:range skos:Requirement .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/supportsMeasure
skos:supportsMeasure rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf owl:topObjectProperty ;
                     rdfs:domain skos:Tool ;
                     rdfs:range skos:Measure .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#rank
:rank rdf:type owl:DatatypeProperty ,
               owl:FunctionalProperty ;
      rdfs:domain skos:RiskGroup ;
      rdfs:range xsd:integer .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#stageNumber
:stageNumber rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdf:type owl:FunctionalProperty ;
             rdfs:range xsd:integer ;
             rdfs:comment "Numbering used by the Algoritmekader. Not a required sequence, and not linear. Stages can be re-iterated over"@en .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#Role
:Role rdf:type owl:Class .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/AIActRole
skos:AIActRole rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( :role-aanbieder
                                                 :role-distributeur
                                                 :role-gebruiksverantwoordelijke
                                                 :role-gemachtigde
                                                 :role-importeur
                                                 :role-productfabrikant
                                               )
                                   ] ;
               rdfs:subClassOf :Role ;
               owl:disjointWith skos:AlgoritmekaderRole ;
               rdfs:label "Rol AI Act"@nl ,
                          "Role AI Act"@en .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/AISystem
skos:AISystem rdf:type owl:Class ;
              rdfs:label "AI Systeem"@nl ,
                         "AI System"@en .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/AlgoritmekaderRole
skos:AlgoritmekaderRole rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( :role-beleid-en-advies
                                                          :role-jurist
                                                          :role-ontwikkelaar
                                                          :role-projectleider
                                                        )
                                            ] ;
                        rdfs:subClassOf :Role ;
                        rdfs:label "Algoritmekader role"@en .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/AssessmentFramework
skos:AssessmentFramework rdf:type owl:Class ;
                         rdfs:subClassOf skos:Tool ;
                         rdfs:comment "CSV value: toetsingskader" ;
                         rdfs:label "Assessment Framework"@en ,
                                    "Toetsingskader"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Document
skos:Document rdf:type owl:Class .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Factsheet
skos:Factsheet rdf:type owl:Class ;
               rdfs:subClassOf skos:Tool ;
               rdfs:comment "CSV value: factsheet" ;
               rdfs:label "Factsheet"@en ,
                          "Factsheet"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/GovernanceObligation
skos:GovernanceObligation rdf:type owl:Class ;
                          rdfs:subClassOf skos:Requirement .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Guidance
skos:Guidance rdf:type owl:Class ;
              rdfs:subClassOf skos:Tool ;
              rdfs:comment "CSV value: handreiking" ;
              rdfs:label "Guidance"@en ,
                         "Handreiking"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/ImpactAssessment
skos:ImpactAssessment rdf:type owl:Class ;
                      rdfs:subClassOf skos:Tool ;
                      rdfs:comment "CSV value: impact-assessment" ;
                      rdfs:label "Impact Assessment"@en ,
                                 "Impact Assessment"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/LegalObligation
skos:LegalObligation rdf:type owl:Class ;
                     rdfs:subClassOf skos:Requirement .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/LegalSource
skos:LegalSource rdf:type owl:Class ;
                 rdfs:label "Legal Source"@en ,
                            "Wettelijke bron"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/LifecycleStage
skos:LifecycleStage rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( :stage-dataverkenning-en-datapreparatie
                                                      :stage-implementatie
                                                      :stage-monitoring-en-beheer
                                                      :stage-ontwerp
                                                      :stage-ontwikkelen
                                                      :stage-organisatieverantwoordelijkheden
                                                      :stage-probleemanalyse
                                                      :stage-uitfaseren
                                                      :stage-verificatie-en-validatie
                                                    )
                                        ] ;
                    rdfs:label "Levenscyclusfase"@nl ,
                               "Lifecycle Stage"@en .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Measure
skos:Measure rdf:type owl:Class ;
             rdfs:label "Maatregel"@nl ,
                        "Measure"@en .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Register
skos:Register rdf:type owl:Class ;
              rdfs:subClassOf skos:Tool ;
              rdfs:comment "CSV value: register" ;
              rdfs:label "Register"@nl ,
                         "Registry"@en .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Requirement
skos:Requirement rdf:type owl:Class ;
                 rdfs:label "Requirement"@en ,
                            "Vereiste"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/RiskGroup
skos:RiskGroup rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( :riskgroup-high
                                                 :riskgroup-limited
                                                 :riskgroup-minimal
                                                 :riskgroup-unacceptable
                                               )
                                   ] ;
               rdfs:comment "Valt je AI-systeem onder een risicogroep uit de Europese AI-verordening, dan gelden speciale regels. Hoe groter het risico voor de samenleving, hoe strenger de regels. Het hangt ervan af waarvoor je het AI-systeem gebruikt."@nl ;
               rdfs:label "Risico Groep"@nl ,
                          "Risk Group"@en .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Roadmap
skos:Roadmap rdf:type owl:Class ;
             rdfs:subClassOf skos:Tool ;
             rdfs:comment "CSV value: roadmap" ;
             rdfs:label "Roadmap"@en ,
                        "Roadmap"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/SelfAssessment
skos:SelfAssessment rdf:type owl:Class ;
                    rdfs:subClassOf skos:Tool ;
                    rdfs:comment "CSV value: self-assessment" ;
                    rdfs:label "Self-Assessment"@en ,
                               "Self-Assessment"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Standard
skos:Standard rdf:type owl:Class ;
              rdfs:subClassOf skos:Tool ;
              rdfs:comment "CSV value: standaard" ;
              rdfs:label "Standaard"@nl ,
                         "Standard"@en .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/SubjectAK
skos:SubjectAK rdf:type owl:Class ;
               rdfs:label "Onderwerp Algoritmekader"@nl ,
                          "Subject Algoritmekader"@en .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Template
skos:Template rdf:type owl:Class ;
              rdfs:subClassOf skos:Tool ;
              rdfs:comment "CSV value: template" ;
              rdfs:label "Template"@en ,
                         "Template"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Tool
skos:Tool rdf:type owl:Class ;
          rdfs:subClassOf skos:Document ;
          rdfs:comment "This class denotes the 'Hulpmiddelen' as defined in the Algoritmekader"@en ;
          rdfs:label "Hulpmiddel"@nl ,
                     "Tool"@en .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#riskgroup-high
:riskgroup-high rdf:type owl:NamedIndividual ,
                         skos:RiskGroup ;
                :rank 3 .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#riskgroup-limited
:riskgroup-limited rdf:type owl:NamedIndividual ,
                            skos:RiskGroup ;
                   :rank 2 .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#riskgroup-minimal
:riskgroup-minimal rdf:type owl:NamedIndividual ,
                            skos:RiskGroup ;
                   :rank 1 .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#riskgroup-unacceptable
:riskgroup-unacceptable rdf:type owl:NamedIndividual ,
                                 skos:RiskGroup ;
                        :rank 4 .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#role-aanbieder
:role-aanbieder rdf:type owl:NamedIndividual ,
                         skos:AIActRole ;
                rdfs:comment "Een natuurlijke of rechtspersoon, overheidsinstantie, agentschap of ander orgaan die/dat een AI-systeem of een AI-model voor algemene doeleinden ontwikkelt of laat ontwikkelen en dat systeem of model in de handel brengt of het AI-systeem in gebruik stelt onder de eigen naam of merk, al dan niet tegen betaling."@nl ;
                rdfs:label "Aanbieder"@nl ,
                           "Provider"@en .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#role-beleid-en-advies
:role-beleid-en-advies rdf:type owl:NamedIndividual ,
                                skos:AlgoritmekaderRole ;
                       rdfs:comment "Dit zijn professionals die ervoor zorgen dat de organisatie algoritmes verantwoord en volgens de beleidsdoelen ontwikkelt en inzet. Bijvoorbeeld een beleidsmedewerker, ethicus, CIO-adviseur of architect."@nl ;
                       rdfs:label "Beleid en advies"@nl ,
                                  "Policy and Advisory"@en .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#role-distributeur
:role-distributeur rdf:type owl:NamedIndividual ,
                            skos:AIActRole ;
                   rdfs:label "Distributeur"@nl ,
                              "Distributor"@en .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#role-gebruiksverantwoordelijke
:role-gebruiksverantwoordelijke rdf:type owl:NamedIndividual ,
                                         skos:AIActRole ;
                                rdfs:comment "Een natuurlijke of rechtspersoon, overheidsinstantie, agentschap of ander orgaan die/dat een AI-systeem onder eigen verantwoordelijkheid gebruikt, tenzij het AI-systeem wordt gebruikt in het kader van een persoonlijke niet- beroepsactiviteit."@nl ;
                                rdfs:label "Deployer"@en ,
                                           "Gebruiksverantwoordelijke"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#role-gemachtigde
:role-gemachtigde rdf:type owl:NamedIndividual ,
                           skos:AIActRole ;
                  rdfs:comment "Een natuurlijke of rechtspersoon die zich bevindt of gevestigd is in de Unie die een schriftelijke machtiging heeft gekregen en aanvaard van een aanbieder van een AI-systeem of een AI-model voor algemene doeleinden om namens die aanbieder de verplichtingen en procedures van deze verordening respectievelijk na te komen en uit te voeren."@nl ;
                  rdfs:label "Authorised representative"@en ,
                             "Gemachtigde"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#role-importeur
:role-importeur rdf:type owl:NamedIndividual ,
                         skos:AIActRole ;
                rdfs:comment "Any natural or legal person established in the European Union that places on the market an AI system bearing the name or trademark of a person established outside the EU."@en ,
                             "Een natuurlijke of rechtspersoon die zich bevindt of gevestigd is in de Unie die een AI-systeem in de handel brengt dat de naam of merknaam van een in een derde land gevestigde natuurlijke of rechtspersoon draagt."@nl ;
                rdfs:label "Importer"@en ,
                           "Importeur"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#role-jurist
:role-jurist rdf:type owl:NamedIndividual ,
                      skos:AlgoritmekaderRole ;
             rdfs:comment "Juristen zorgen ervoor dat de organisatie bij het ontwikkelen en gebruiken van algoritmes voldoet aan de wettelijke verplichtingen en beginselen van behoorlijk bestuur. Bijvoorbeeld een privacy-jurist, compliance-officer of functionaris gegevensbescherming (FG)."@nl ;
             rdfs:label "Jurist"@nl ,
                        "Legal"@en .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#role-ontwikkelaar
:role-ontwikkelaar rdf:type owl:NamedIndividual ,
                            skos:AlgoritmekaderRole ;
                   rdfs:comment "Ontwikkelaars zijn technische experts die ervoor zorgen dat algoritmes voldoen aan technische en ethische standaarden. Bijvoorbeeld een data-scientist, developer of informatieanalist."@nl ;
                   rdfs:label "Developer"@en ,
                              "Ontwikkelaar"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#role-productfabrikant
:role-productfabrikant rdf:type owl:NamedIndividual ,
                                skos:AIActRole ;
                       rdfs:label "Product manufacturer"@en ,
                                  "Productfabrikant"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#role-projectleider
:role-projectleider rdf:type owl:NamedIndividual ,
                             skos:AlgoritmekaderRole ;
                    rdfs:comment "Projectleider verbinden de benodigde expertises en waarborgen alle stappen van het ontwikkelproces. Bijvoorbeeld een product-owner, proceseigenaar of IT-projectmanager."@nl ;
                    rdfs:label "Project lead"@en ,
                               "Projectleider"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#stage-dataverkenning-en-datapreparatie
:stage-dataverkenning-en-datapreparatie rdf:type owl:NamedIndividual ,
                                                 skos:LifecycleStage ;
                                        :stageNumber 3 ;
                                        rdfs:label "3. Data Exploration and Data Preparation"@en ,
                                                   "3. Dataverkenning en datapreparatie"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#stage-implementatie
:stage-implementatie rdf:type owl:NamedIndividual ,
                              skos:LifecycleStage ;
                     :stageNumber 6 ;
                     rdfs:label "6. Implementatie"@nl ,
                                "6. Implementation"@en .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#stage-monitoring-en-beheer
:stage-monitoring-en-beheer rdf:type owl:NamedIndividual ,
                                     skos:LifecycleStage ;
                            :stageNumber 7 ;
                            rdfs:label "7. Monitoring and Management"@en ,
                                       "7. Monitoring en beheer"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#stage-ontwerp
:stage-ontwerp rdf:type owl:NamedIndividual ,
                        skos:LifecycleStage ;
               :stageNumber 2 ;
               rdfs:label "2. Design"@en ,
                          "2. Ontwerp"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#stage-ontwikkelen
:stage-ontwikkelen rdf:type owl:NamedIndividual ,
                            skos:LifecycleStage ;
                   :stageNumber 4 ;
                   rdfs:label "4. Development"@en ,
                              "4. Ontwikkelen"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#stage-organisatieverantwoordelijkheden
:stage-organisatieverantwoordelijkheden rdf:type owl:NamedIndividual ,
                                                 skos:LifecycleStage ;
                                        :stageNumber 0 ;
                                        rdfs:label "0. Organisatieverantwoordelijkheden"@nl ,
                                                   "0. Organisational Responsibilities"@en .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#stage-probleemanalyse
:stage-probleemanalyse rdf:type owl:NamedIndividual ,
                                skos:LifecycleStage ;
                       :stageNumber 1 ;
                       rdfs:label "1. Probleemanalyse"@nl ,
                                  "1. Problem Analysis"@en .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#stage-uitfaseren
:stage-uitfaseren rdf:type owl:NamedIndividual ,
                           skos:LifecycleStage ;
                  :stageNumber 8 ;
                  rdfs:label "8. Decommissioning"@en ,
                             "8. Uitfaseren"@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#stage-verificatie-en-validatie
:stage-verificatie-en-validatie rdf:type owl:NamedIndividual ,
                                         skos:LifecycleStage ;
                                :stageNumber 5 ;
                                rdfs:label "5. Verificatie en validatie"@nl ,
                                           "5. Verification and validation"@en .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :riskgroup-high
                        :riskgroup-limited
                        :riskgroup-minimal
                        :riskgroup-unacceptable
                        :role-aanbieder
                        :role-beleid-en-advies
                        :role-distributeur
                        :role-gebruiksverantwoordelijke
                        :role-gemachtigde
                        :role-importeur
                        :role-jurist
                        :role-ontwikkelaar
                        :role-productfabrikant
                        :role-projectleider
                        :stage-dataverkenning-en-datapreparatie
                        :stage-implementatie
                        :stage-monitoring-en-beheer
                        :stage-ontwerp
                        :stage-ontwikkelen
                        :stage-organisatieverantwoordelijkheden
                        :stage-probleemanalyse
                        :stage-uitfaseren
                        :stage-verificatie-en-validatie
                      )
] .


