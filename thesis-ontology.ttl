<http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance> rdf:type owl:Ontology ;
                                                                               rdfs:comment "This is an ontology containing the AI Act and the Dutch Algoritmekader"@en .

#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#LegalSource
:LegalSource rdf:type owl:Class .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance#Measure
:Measure rdf:type owl:Class .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/AISystem
:AISystem rdf:type owl:Class .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Aids
:Aids rdf:type owl:Class ;
      rdfs:subClassOf :Documents ;
      rdfs:comment "This class denotes the 'Hulpmiddelen' as defined in the Algoritmekader" .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Beleid_en_advies
:Beleid_en_advies rdf:type owl:Class ;
                  rdfs:subClassOf :Role ;
                  rdfs:comment "Dit zijn professionals die ervoor zorgen dat de organisatie algoritmes verantwoord en volgens de beleidsdoelen ontwikkelt en inzet. Bijvoorbeeld een beleidsmedewerker, ethicus, CIO-adviseur of architect."@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Documents
:Documents rdf:type owl:Class .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/GeneralPurposeAISystem
:GeneralPurposeAISystem rdf:type owl:Class ;
                        rdfs:subClassOf :AISystem .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/GovernanceDocuments
:GovernanceDocuments rdf:type owl:Class ;
                     rdfs:subClassOf :Documents .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/GovernanceObligations
:GovernanceObligations rdf:type owl:Class ;
                       rdfs:subClassOf :Requirement .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/HighRiskAISystem
:HighRiskAISystem rdf:type owl:Class ;
                  rdfs:subClassOf :AISystem .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Jurist
:Jurist rdf:type owl:Class ;
        rdfs:subClassOf :Role ;
        rdfs:comment "Juristen zorgen ervoor dat de organisatie bij het ontwikkelen en gebruiken van algoritmes voldoet aan de wettelijke verplichtingen en beginselen van behoorlijk bestuur. Bijvoorbeeld een privacy-jurist, compliance-officer of functionaris gegevensbescherming (FG)."@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/LegalDocuments
:LegalDocuments rdf:type owl:Class ;
                rdfs:subClassOf :Documents .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/LegalObligations
:LegalObligations rdf:type owl:Class ;
                  rdfs:subClassOf :Requirement .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Lifecycle
:Lifecycle rdf:type owl:Class .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Ontwikkelaar
:Ontwikkelaar rdf:type owl:Class ;
              rdfs:subClassOf :Role ;
              rdfs:comment "Ontwikkelaars zijn technische experts die ervoor zorgen dat algoritmes voldoen aan technische en ethische standaarden. Bijvoorbeeld een data-scientist, developer of informatieanalist."@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/ProhibitedAISystem
:ProhibitedAISystem rdf:type owl:Class ;
                    rdfs:subClassOf :AISystem .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Projectleider
:Projectleider rdf:type owl:Class ;
               rdfs:subClassOf :Role ;
               rdfs:comment "Projectleider verbinden de benodigde expertises en waarborgen alle stappen van het ontwikkelproces. Bijvoorbeeld een product-owner, proceseigenaar of IT-projectmanager."@nl .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Requirement
:Requirement rdf:type owl:Class .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/RiskGroup
:RiskGroup rdf:type owl:Class .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/Role
:Role rdf:type owl:Class .


###  http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/SelfAssessments
:SelfAssessments rdf:type owl:Class ;
                 rdfs:subClassOf :Documents .


