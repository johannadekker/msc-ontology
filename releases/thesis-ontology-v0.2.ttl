        owl:NamedIndividual ;
    rdfs:label "AI Act"@en,
        "AI Verordening"@nl ;
    :csvValue "aia" .

:stage-organisatieverantwoordelijkheden a :LifecycleStage,
        owl:NamedIndividual ;
    rdfs:label "0. Organisational Responsibilities"@en,
