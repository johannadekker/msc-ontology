    rdfs:label "Hoog-risico-AI-systemen zijn voldoende nauwkeurig, robuust en cyberveilig"@nl ;
    :appliesToApplication :AISystem,
        :GeneralPurposeAISystem ;
    :appliesToRiskGroup :riskgroup-high ;
