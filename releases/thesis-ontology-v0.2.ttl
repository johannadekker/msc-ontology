    :relevantForRole :role-beleid-en-advies,
        :role-ontwikkelaar,
        :role-projectleider .

:role-distributeur a :AIActRole,
        owl:NamedIndividual ;
    rdfs:label "Distributor"@en,
        "Distributeur"@nl .

:role-importeur a :AIActRole,
        owl:NamedIndividual ;
    rdfs:label "Importer"@en,
        "Importeur"@nl ;
    rdfs:comment "Any natural or legal person established in the European Union that places on the market an AI system bearing the name or trademark of a person established outside the EU."@en,
        "Een natuurlijke of rechtspersoon die zich bevindt of gevestigd is in de Unie die een AI-systeem in de handel brengt dat de naam of merknaam van een in een derde land gevestigde natuurlijke of rechtspersoon draagt."@nl .

:riskgroup-not-high a :RiskGroup,
        owl:NamedIndividual ;
    rdfs:label "Not a High-Risk AI System"@en,
        "Geen hoog-risico AI systeem"@nl ;
    :rank 1 .

:GeneralPurposeAIModel a owl:Class ;
    rdfs:label "General Purpose AI Model"@en,
        "AI model voor algemene doeleinden"@nl ;
    :csvValue "ai-model-voor-algemene-doeleinden" ;
    rdfs:subClassOf :AIApplication .

:stage-dataverkenning-en-datapreparatie a :LifecycleStage,
        owl:NamedIndividual ;
    rdfs:label "3. Data Exploration and Data Preparation"@en,
