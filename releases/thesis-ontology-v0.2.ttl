@prefix : <http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.semanticweb.org/johannadekker/ontologies/2026/9/NL-AI-Governance> a owl:Ontology ;
    rdfs:comment "This is an ontology containing the AI Act and the Dutch Algoritmekader"@en ;
    owl:imports <http://www.w3.org/2004/02/skos/core> .

:GovernanceObligation a owl:Class ;
    rdfs:subClassOf :Requirement .

:LegalObligation a owl:Class ;
    rdfs:subClassOf :Requirement .

:SubjectAK a owl:Class ;
    rdfs:label "Subject Algoritmekader"@en,
        "Onderwerp Algoritmekader"@nl .

:appliesToApplication a owl:ObjectProperty ;
    rdfs:domain :Requirement .

:appliesToRiskGroup a owl:ObjectProperty ;
    rdfs:domain :Requirement ;
    rdfs:range :RiskGroup .

:appliesToRole a owl:ObjectProperty ;
    rdfs:domain :Requirement ;
    rdfs:range :AIActRole ;
    rdfs:subPropertyOf owl:topObjectProperty .

:appliesToStage a owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty .

:appliesToTransparencyStatus a owl:ObjectProperty ;
    rdfs:domain :Requirement ;
    rdfs:range :TransparencyStatus .

:csvValue a owl:AnnotationProperty ;
    rdfs:comment "The value this individual stands for in the Algoritmekader csv files"@en .

:derivedFrom a owl:ObjectProperty ;
    rdfs:domain :Requirement ;
    rdfs:range :LegalSource .

:hasRiskGroup a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :AIApplication ;
    rdfs:range :RiskGroup .

:implements a owl:ObjectProperty ;
    rdfs:domain :Measure ;
    rdfs:range :Requirement .

:measure-dat-04 a :Measure ;
    rdfs:label "Bescherm persoonsgegevens door data te anonimiseren, pseudonimiseren of te aggregeren"@nl ;
    :appliesToStage :stage-dataverkenning-en-datapreparatie,
        :stage-ontwikkelen ;
    :implements :requirement-avg-03,
        :requirement-avg-12 ;
    :relevantForRole :role-jurist,
        :role-ontwikkelaar .

:measure-dat-05 a :Measure ;
    rdfs:label "Controleer de auteursrechten van eigen data"@nl ;
    :appliesToStage :stage-dataverkenning-en-datapreparatie,
        :stage-ontwerp ;
    :implements :requirement-aut-01 ;
    :relevantForRole :role-jurist .

:measure-dat-06 a :Measure ;
    rdfs:label "Gebruik duurzame datacenters"@nl ;
    :appliesToStage :stage-dataverkenning-en-datapreparatie,
        :stage-implementatie,
        :stage-monitoring-en-beheer,
        :stage-ontwerp,
        :stage-ontwikkelen ;
    :relevantForRole :role-beleid-en-advies,
        :role-ontwikkelaar,
        :role-projectleider .

:measure-dat-07 a :Measure ;
    rdfs:label "Gebruik bij machine learning technieken gescheiden train-, test- en validatiedata en houd rekening met underfitting en overfitting"@nl ;
    :appliesToStage :stage-dataverkenning-en-datapreparatie,
        :stage-ontwikkelen ;
    :implements :requirement-aia-10 ;
    :relevantForRole :role-ontwikkelaar .

:measure-dat-09 a :Measure ;
    rdfs:label "Beperk de omvang van datasets voor energie-efficiëntie"@nl ;
    :appliesToStage :stage-dataverkenning-en-datapreparatie,
        :stage-ontwikkelen ;
    :relevantForRole :role-ontwikkelaar,
        :role-projectleider .

:measure-dat-10 a :Measure ;
    rdfs:label "Controleer de data op manipulatie en ongewenste afhankelijkheden"@nl ;
    :appliesToStage :stage-dataverkenning-en-datapreparatie,
        :stage-monitoring-en-beheer ;
    :implements :requirement-aia-10,
        :requirement-aia-22,
        :requirement-aia-32,
        :requirement-avg-12,
        :requirement-bio-01 ;
    :relevantForRole :role-beleid-en-advies,
        :role-ontwikkelaar .

:measure-dat-11 a :Measure ;
    rdfs:label "Controleer de input van gebruikers op misleiding"@nl ;
    :appliesToStage :stage-dataverkenning-en-datapreparatie,
        :stage-monitoring-en-beheer ;
    :implements :requirement-aia-10,
        :requirement-aia-22,
        :requirement-aia-32,
        :requirement-avg-12,
        :requirement-bio-01 ;
    :relevantForRole :role-ontwikkelaar .

:measure-dat-12 a :Measure ;
    rdfs:label "Maak waardevolle data vindbaar, toegankelijk, interoperabel en herbruikbaar (FAIR) binnen en buiten de eigen organisatie"@nl ;
    :appliesToStage :stage-dataverkenning-en-datapreparatie ;
    :relevantForRole :role-ontwikkelaar .

:measure-imp-01 a :Measure ;
    rdfs:label "Stel een werkinstructie op voor gebruikers"@nl ;
    :appliesToStage :stage-implementatie ;
    :implements :requirement-aia-01,
        :requirement-aia-09,
        :requirement-aia-21,
        :requirement-aia-28,
        :requirement-awb-01,
        :requirement-grw-02 ;
    :relevantForRole :role-beleid-en-advies,
        :role-projectleider .

:measure-imp-05 a :Measure ;
    rdfs:label "Vermeld het gebruik van persoonsgegevens in een privacyverklaring"@nl ;
    :appliesToStage :stage-implementatie ;
    :implements :requirement-avg-07 ;
    :relevantForRole :role-jurist,
        :role-projectleider .

:measure-imp-06 a :Measure ;
    rdfs:label "Richt een proces in zodat burgers of andere belanghebbenden een klacht, bezwaar of beroep kunnen indienen over het gebruik van het algoritme en monitor dit proces"@nl ;
    :appliesToStage :stage-implementatie,
        :stage-monitoring-en-beheer ;
    :implements :requirement-avg-09 ;
    :relevantForRole :role-ontwikkelaar,
        :role-projectleider .

:measure-imp-07 a :Measure ;
    rdfs:label "Vermeld het gebruik van persoonsgegevens in het verwerkingsregister"@nl ;
    :appliesToStage :stage-implementatie ;
    :implements :requirement-avg-07 ;
    :relevantForRole :role-jurist,
        :role-projectleider .

:measure-imp-08 a :Measure ;
    rdfs:label "Maak een openbaar besluit over de inzet van het algoritme"@nl ;
    :appliesToStage :stage-implementatie,
        :stage-organisatieverantwoordelijkheden ;
    :implements :requirement-aia-08,
        :requirement-aia-21,
        :requirement-aia-22,
        :requirement-awb-01,
        :requirement-awb-02 ;
    :relevantForRole :role-projectleider .

:measure-imp-09 a :Measure ;
    rdfs:label "Neem technische interventies op in de gebruikersinterface om verkeerd gebruik te voorkomen"@nl ;
    :appliesToStage :stage-implementatie,
        :stage-ontwikkelen ;
    :implements :requirement-aia-10 ;
    :relevantForRole :role-beleid-en-advies,
        :role-ontwikkelaar,
        :role-projectleider .

:measure-mon-04 a :Measure ;
    rdfs:label "Maak een evaluatieplan voor tijdens het gebruik van het algoritme"@nl ;
    :appliesToStage :stage-monitoring-en-beheer ;
    :implements :requirement-aia-03,
        :requirement-aia-18,
        :requirement-aia-22,
        :requirement-aia-34 ;
    :relevantForRole :role-projectleider .

:measure-mon-06 a :Measure ;
    rdfs:label "Meten, monitoren en rapporteren van milieu-impact van algoritmes"@nl ;
    :appliesToStage :stage-monitoring-en-beheer,
        :stage-ontwerp ;
    :relevantForRole :role-beleid-en-advies,
        :role-ontwikkelaar,
        :role-projectleider .

:measure-org-06 a :Measure ;
    rdfs:label "Gebruik een algoritme volwassenheidsmodel om te weten waar de organisatie staat"@nl ;
    :appliesToStage :stage-organisatieverantwoordelijkheden ;
    :relevantForRole :role-beleid-en-advies,
        :role-projectleider .

:measure-org-07 a :Measure ;
    rdfs:label "Richt een algoritmegovernance in op basis van het Three Lines-model"@nl ;
    :appliesToStage :stage-organisatieverantwoordelijkheden ;
    :relevantForRole :role-beleid-en-advies,
        :role-projectleider .

:measure-org-08 a :Measure ;
    rdfs:label "Richt vaste beslismomenten en controlepunten in in de algoritmelevenscyclus"@nl ;
